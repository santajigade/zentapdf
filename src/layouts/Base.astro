---
import '../styles/global.css';
import { SITE_NAME, SITE_URL, GA4_ID, GSC_VERIFICATION, ADSENSE_CLIENT } from '../config.js';
import { categories, tools } from '../data/tools';
import { icon } from '../data/icons';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, schema = [], ogImage = '/og-default.png', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const liveTools = tools.filter((t) => t.live);
const year = new Date().getFullYear();
const orgSchema = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: SITE_URL + '/',
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#4F46E5" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, SITE_URL).href} />
  <meta name="twitter:card" content="summary_large_image" />
  {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
  <script is:inline>
    (function () {
      var t = null;
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = t;
    })();
  </script>
  <script type="application/ld+json" set:html={JSON.stringify([orgSchema, ...schema])} />
  {GA4_ID && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
      <script is:inline define:vars={{ GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date()); gtag('config', GA4_ID);
      </script>
    </>
  )}
  {ADSENSE_CLIENT && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="container">
      <a class="logo" href="/">
        <img src="/logo.svg" width="32" height="32" alt="" />
        <span>Zenta<b>PDF</b></span>
      </a>
      <nav class="nav" aria-label="Main">
        {categories.slice(0, 4).map((c) => <a class="hide-sm" href={`/${c.slug}/`}>{c.name.replace(' PDF', '')}</a>)}
        <a class="hide-sm" href="/image-tools/">Images</a>
        <a href="/#all-tools">All tools</a>
        <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch light or dark mode">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <div class="foot-grid">
        <div class="foot-brand">
          <a class="logo" href="/"><img src="/logo.svg" width="28" height="28" alt="" /><span>Zenta<b>PDF</b></span></a>
          <p>Free PDF and image tools. Your files are processed in your browser and never leave your device.</p>
          <button class="btn btn-ghost share-btn" id="share-btn" type="button">Share this tool</button>
        </div>
        <div>
          <h3>PDF tools</h3>
          <ul>{liveTools.filter((t) => t.category !== 'image').map((t) => <li><a href={`/${t.slug}/`}>{t.name}</a></li>)}</ul>
        </div>
        <div>
          <h3>Image tools</h3>
          <ul>
            {liveTools.filter((t) => t.category === 'image').map((t) => <li><a href={`/${t.slug}/`}>{t.name}</a></li>)}
            <li><a href="/#all-tools">All tools</a></li>
          </ul>
        </div>
        <div>
          <h3>Company</h3>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/privacy-policy/">Privacy Policy</a></li>
            <li><a href="/terms/">Terms of Use</a></li>
            <li><a href="/disclaimer/">Disclaimer</a></li>
          </ul>
        </div>
      </div>
      <p class="copy">© {year} {SITE_NAME}. All rights reserved.</p>
    </div>
  </footer>
  <script>
    const btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
    const share = document.getElementById('share-btn');
    share?.addEventListener('click', async () => {
      const data = { title: document.title, url: location.href };
      try {
        if (navigator.share) await navigator.share(data);
        else { await navigator.clipboard.writeText(location.href); share.textContent = 'Link copied!'; }
      } catch (e) {}
    });
  </script>
</body>
</html>
