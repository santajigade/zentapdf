---
import '../styles/global.css';
import { SITE_NAME, SITE_URL, GA4_ID, GSC_VERIFICATION, ADSENSE_CLIENT } from '../config.js';
import { categories, tools } from '../data/tools';
import { icon } from '../data/icons';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  ogImage?: string;
  noindex?: boolean;
  ogType?: string;
}
const { title, description, schema = [], ogImage = '/og-default.png', noindex = false, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const liveTools = tools.filter((t) => t.live);
const footCols = [
  { title: 'Organise PDF', all: '/organise-pdf/', slugs: ['merge-pdf', 'split-pdf', 'remove-pages', 'extract-pages', 'rotate-pdf'] },
  { title: 'Edit PDF', all: '/edit-pdf-tools/', slugs: ['edit-pdf', 'sign-pdf', 'add-watermark', 'add-page-numbers', 'crop-pdf'] },
  { title: 'Convert', all: '/convert-pdf/', slugs: ['pdf-to-word', 'word-to-pdf', 'pdf-to-excel', 'jpg-to-pdf', 'pdf-to-jpg'] },
  { title: 'Image tools', all: '/image-tools/', slugs: ['compress-image', 'resize-image', 'crop-image', 'convert-image', 'rotate-image'] },
];
const year = new Date().getFullYear();
const SOCIAL = [
  { name: 'LinkedIn', url: 'https://www.linkedin.com/company/zentapdf/', color: '#0a66c2', icon: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z' },
  { name: 'YouTube', url: 'https://www.youtube.com/@ZentaPDF', color: '#ff0000', icon: 'M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z' },
  { name: 'Instagram', url: 'https://www.instagram.com/zentapdf/', color: '#e1306c', icon: 'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.13 1.38A5.9 5.9 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13a5.9 5.9 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.38 5.9 5.9 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.13A5.9 5.9 0 0 0 19.86.63C19.1.33 18.22.13 16.95.07 15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z' },
  { name: 'Facebook', url: 'https://www.facebook.com/zentapdf', color: '#1877f2', icon: 'M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07z' },
];
const orgSchema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: SITE_URL + '/' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE_NAME, url: SITE_URL + '/', logo: SITE_URL + '/favicon-512.png', slogan: 'Free PDF & image tools.',
    sameAs: SOCIAL.map((x) => x.url) },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#4F46E5" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, SITE_URL).href} />
  <meta name="twitter:card" content="summary_large_image" />
  {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
  <script is:inline>
    (function () {
      var t = null;
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = t;
    })();
  </script>
  <script type="application/ld+json" set:html={JSON.stringify([...orgSchema, ...schema])} />
  {GA4_ID && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
      <script is:inline define:vars={{ GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date()); gtag('config', GA4_ID);
      </script>
    </>
  )}
  {ADSENSE_CLIENT && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="container">
      <a class="logo" href="/">
        <img src="/logo.svg" width="32" height="32" alt="" />
        <span>Zenta<b>PDF</b></span>
      </a>
      <nav class="nav" aria-label="Main">
        {categories.slice(0, 4).map((c) => <a class="hide-sm" href={`/${c.slug}/`}>{c.name.replace(' PDF', '')}</a>)}
        <a class="hide-sm" href="/image-tools/">Images</a>
        <a class="hide-sm" href="/gif-tools/">GIF</a>
        <a class="hide-sm" href="/device-test/">Device Test</a>
        <a href="/templates/">Templates</a>
        <a class="hide-xs" href="/guides/">Guides</a>
        <a href="/#all-tools">All tools</a>
        <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch light or dark mode">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <div class="foot-grid">
        <div class="foot-brand">
          <a class="logo" href="/"><img src="/logo.svg" width="28" height="28" alt="" /><span>Zenta<b>PDF</b></span></a>
          <p>Free online PDF and image tools. Fast, simple and no sign-up.</p>
          <ul class="social" aria-label="Follow ZentaPDF">
            {SOCIAL.map((x) => <li><a href={x.url} target="_blank" rel="noopener me" aria-label={`ZentaPDF on ${x.name}`} title={x.name} style={`--sc:${x.color}`}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={x.icon} fill="currentColor" /></svg></a></li>)}
          </ul>
          <button class="btn btn-ghost share-btn" id="share-btn" type="button">Share this tool</button>
        </div>
        {footCols.map((c) => (
          <div>
            <h3>{c.title}</h3>
            <ul>
              {c.slugs.map((sl) => { const t = tools.find((x) => x.slug === sl && x.live); return t && <li><a href={`/${t.slug}/`}>{t.name}</a></li>; })}
              <li><a class="more" href={c.all}>View all →</a></li>
            </ul>
          </div>
        ))}
        <div>
          <h3>Company</h3>
          <ul>
            <li><a href="/templates/">Free Templates</a></li>
            <li><a href="/guides/">Guides</a></li>
            <li><a href="/device-test/">Device Test</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/privacy-policy/">Privacy Policy</a></li>
            <li><a href="/terms/">Terms of Use</a></li>
            <li><a href="/disclaimer/">Disclaimer</a></li>
          </ul>
        </div>
      </div>
      <div class="foot-bottom">
        <p class="copy">© {year} {SITE_NAME}. All rights reserved.</p>
        <a class="foot-sister" href="https://zentacalculator.com/" title="Zenta Calculator: free online calculators">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="2.5" width="14" height="19" rx="2.5"/><path d="M8 6.5h8v3H8zM8.5 13h.01M12 13h.01M15.5 13h.01M8.5 17h.01M12 17h.01M15.5 17h.01"/></svg>
          <span><b>Free Online Calculators</b><small>Engineering, finance and everyday calculators on Zenta Calculator</small></span>
        </a>
      </div>
    </div>
  </footer>
  <script>
    const btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
    const share = document.getElementById('share-btn');
    share?.addEventListener('click', async () => {
      const data = { title: document.title, url: location.href };
      try {
        if (navigator.share) await navigator.share(data);
        else { await navigator.clipboard.writeText(location.href); share.textContent = 'Link copied!'; }
      } catch (e) {}
    });
  </script>
</body>
</html>
