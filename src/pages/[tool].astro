---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolCard from '../components/ToolCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { tools, toolBySlug, categoryById, type Tool } from '../data/tools';
import { guidesForTool } from '../lib/guides';
import { breadcrumbSchema, faqSchema, howToSchema, appSchema } from '../lib/schema';
import MergePdf from '../components/tools/MergePdf';
import SplitPdf from '../components/tools/SplitPdf';
import JpgToPdf from '../components/tools/JpgToPdf';
import PdfToJpg from '../components/tools/PdfToJpg';
import CompressImage from '../components/tools/CompressImage';
import ResizeImage from '../components/tools/ResizeImage';
import CropImage from '../components/tools/CropImage';
import ConvertImage from '../components/tools/ConvertImage';
import RotateImage from '../components/tools/RotateImage';
import ImageToBase64 from '../components/tools/ImageToBase64';
import PdfPages from '../components/tools/PdfPages';
import PdfEdit from '../components/tools/PdfEdit';
import PdfEditor from '../components/tools/PdfEditor';
import FormatConvert from '../components/tools/FormatConvert';
import PdfToText from '../components/tools/PdfToText';
import CompressPdf from '../components/tools/CompressPdf';
import PdfPassword from '../components/tools/PdfPassword';
import TargetSize from '../components/tools/TargetSize';
import QrCode from '../components/tools/QrCode';
import Barcode from '../components/tools/Barcode';
import Favicon from '../components/tools/Favicon';
import ExifTool from '../components/tools/ExifTool';
import StickerMaker from '../components/tools/StickerMaker';
import GifEdit from '../components/tools/GifEdit';
import GifMaker from '../components/tools/GifMaker';
import VideoToGif from '../components/tools/VideoToGif';
import PdfToGif from '../components/tools/PdfToGif';
import DocToPdf from '../components/tools/DocToPdf';
import ZipToPdf from '../components/tools/ZipToPdf';
import PdfToPpt from '../components/tools/PdfToPpt';
import RedactPdf from '../components/tools/RedactPdf';
import FormFiller from '../components/tools/FormFiller';
import PdfReader from '../components/tools/PdfReader';
import ScanToPdf from '../components/tools/ScanToPdf';
import PdfToWord from '../components/tools/PdfToWord';
import PdfToExcel from '../components/tools/PdfToExcel';
import OfficeToPdf from '../components/tools/OfficeToPdf';
import PdfPlus from '../components/tools/PdfPlus';

export function getStaticPaths() {
  return tools.filter((t) => t.live).map((t) => ({ params: { tool: t.slug }, props: { tool: t } }));
}
const { tool } = Astro.props as { tool: Tool };
const cat = categoryById(tool.category);
const crumbs = [{ name: 'Home', href: '/' }, { name: cat.name, href: `/${cat.slug}/` }, { name: tool.name, href: `/${tool.slug}/` }];
const related = (tool.related ?? []).map(toolBySlug).filter(Boolean) as Tool[];
// more internal links: every other tool in this category, and the most used tools
const sameCat = tools.filter((t) => t.live && t.category === tool.category && t.slug !== tool.slug && !related.some((r) => r.slug === t.slug));
const POPULAR = ['pdf-to-word', 'compress-pdf', 'merge-pdf', 'jpg-to-pdf', 'edit-pdf', 'pdf-to-excel', 'word-to-pdf', 'compress-image', 'reduce-image-size-in-kb', 'sign-pdf', 'split-pdf', 'pdf-to-jpg'];
const popular = POPULAR.map(toolBySlug).filter((t): t is Tool => !!t && t.live && t.slug !== tool.slug && t.category !== tool.category);
const schema = [
  breadcrumbSchema(crumbs),
  appSchema(tool.name, tool.metaDescription!, `/${tool.slug}/`),
  howToSchema(tool.howToName!, tool.steps!),
  faqSchema(tool.faqs!),
];
const isGen = tool.category === 'utility';
const isImage = tool.category === 'image' || tool.category === 'gif' || tool.category === 'imgconv' || tool.slug === 'jpg-to-pdf' || tool.slug === 'images-to-pdf';
const features = isGen ? [
  { t: 'Free forever', d: 'No sign-up, no watermark and no limits on how many you create.' },
  { t: 'Instant preview', d: 'See the result change as you type, then download in one click.' },
  { t: 'Print quality', d: 'High-resolution PNG and vector SVG downloads where available.' },
  { t: 'Works everywhere', d: 'Use it on Windows, Mac, Linux, Android or iPhone in any modern browser.' },
] : [
  { t: 'Easy to use', d: 'Simple steps, clear buttons — done in a few clicks.' },
  { t: 'Free, no sign-up', d: 'No account, no email, no watermark and no daily limits.' },
  { t: 'Fast', d: 'No waiting — results are ready in seconds.' },
  { t: 'Works everywhere', d: 'Use it on Windows, Mac, Linux, Android or iPhone in any modern browser.' },
  { t: tool.category === 'gif' ? 'Keeps the animation' : isImage ? 'Keeps quality' : 'Original quality', d: tool.category === 'gif' ? 'Every frame and its timing are handled carefully.' : isImage ? 'Smart settings keep your images sharp.' : 'Pages are copied as they are — text and images stay crisp.' },
  { t: 'Large files', d: 'Handle big files and many pages — limited only by your device’s memory.' },
];
---
<Base title={tool.title!} description={tool.metaDescription!} schema={schema} ogImage={`/og/tools/${tool.slug}.png`}>
  <Breadcrumbs items={crumbs} />
  <section class="container narrow">
    <div class="tool-head">
      <h1>{tool.title}</h1>
      <p>{tool.short}</p>
    </div>
    <div class={`tool-box cat-${tool.category}`}>
      {tool.slug === 'merge-pdf' && <MergePdf client:load />}
      {tool.slug === 'split-pdf' && <SplitPdf client:load />}
      {(tool.slug === 'jpg-to-pdf' || tool.slug === 'images-to-pdf') && <JpgToPdf client:load />}
      {tool.slug === 'pdf-to-text' && <PdfToText client:load />}
      {tool.slug === 'qr-code-generator' && <QrCode client:load />}
      {tool.slug === 'barcode-generator' && <Barcode client:load />}
      {tool.slug === 'favicon-generator' && <Favicon client:load />}
      {tool.slug === 'png-to-ico' && <Favicon mode="ico" client:load />}
      {tool.slug === 'exif-viewer' && <ExifTool client:load />}
      {tool.slug === 'remove-exif-data' && <ExifTool mode="remove" client:load />}
      {tool.slug === 'whatsapp-sticker-maker' && <StickerMaker client:load />}
      {tool.slug === 'gif-maker' && <GifMaker client:load />}
      {tool.slug === 'video-to-gif' && <VideoToGif client:load />}
      {tool.slug === 'pdf-to-gif' && <PdfToGif client:load />}
      {tool.slug === 'resize-gif' && <GifEdit mode="resize" client:load />}
      {tool.slug === 'crop-gif' && <GifEdit mode="crop" client:load />}
      {tool.slug === 'compress-gif' && <GifEdit mode="compress" client:load />}
      {tool.slug === 'reverse-gif' && <GifEdit mode="reverse" client:load />}
      {tool.slug === 'gif-speed' && <GifEdit mode="speed" client:load />}
      {tool.slug === 'gif-to-mp4' && <GifEdit mode="mp4" client:load />}
      {tool.slug === 'split-gif' && <GifEdit mode="jpg" client:load />}
      {(tool.slug === 'reduce-image-size-in-kb' || tool.kb) && <TargetSize kb={tool.kb} client:load />}
      {tool.slug === 'compress-pdf' && <CompressPdf client:load />}
      {tool.slug === 'repair-pdf' && <PdfPlus mode="repair" client:load />}
      {tool.slug === 'extract-images-from-pdf' && <PdfPlus mode="extract" client:load />}
      {tool.slug === 'pages-per-sheet' && <PdfPlus mode="nup" client:load />}
      {tool.slug === 'pdf-overlay' && <PdfPlus mode="overlay" client:load />}
      {tool.slug === 'page-size' && <PdfPlus mode="pagesize" client:load />}
      {tool.slug === 'pdf-to-grayscale' && <PdfPlus mode="grayscale" client:load />}
      {tool.slug === 'delete-blank-pages' && <PdfPlus mode="blank" client:load />}
      {tool.slug === 'pdf-to-markdown' && <PdfPlus mode="markdown" client:load />}
      {tool.slug === 'protect-pdf' && <PdfPassword mode="protect" client:load />}
      {tool.slug === 'unlock-pdf' && <PdfPassword mode="unlock" client:load />}
      {tool.slug === 'pdf-to-jpg' && <PdfToJpg client:load />}
      {tool.slug === 'pdf-to-png' && <PdfToJpg initial="png" client:load />}
      {tool.slug === 'pdf-to-ppt' && <PdfToPpt client:load />}
      {tool.slug === 'pdf-scanner' && <ScanToPdf client:load />}
      {tool.slug === 'pdf-to-word' && <PdfToWord client:load />}
      {tool.slug === 'pdf-to-excel' && <PdfToExcel client:load />}
      {tool.slug === 'word-to-pdf' && <OfficeToPdf kind="word" client:load />}
      {tool.slug === 'excel-to-pdf' && <OfficeToPdf kind="excel" client:load />}
      {tool.slug === 'ppt-to-pdf' && <OfficeToPdf kind="ppt" client:load />}
      {tool.slug === 'odt-to-pdf' && <OfficeToPdf kind="odt" client:load />}
      {tool.slug === 'ods-to-pdf' && <OfficeToPdf kind="ods" client:load />}
      {tool.slug === 'odp-to-pdf' && <OfficeToPdf kind="odp" client:load />}
      {tool.slug === 'txt-to-pdf' && <DocToPdf kind="txt" client:load />}
      {tool.slug === 'csv-to-pdf' && <DocToPdf kind="csv" client:load />}
      {tool.slug === 'html-to-pdf' && <DocToPdf kind="html" client:load />}
      {tool.slug === 'epub-to-pdf' && <DocToPdf kind="epub" client:load />}
      {tool.slug === 'rtf-to-pdf' && <DocToPdf kind="rtf" client:load />}
      {tool.slug === 'markdown-to-pdf' && <DocToPdf kind="md" client:load />}
      {tool.slug === 'zip-to-pdf' && <ZipToPdf client:load />}
      {tool.slug === 'pdf-reader' && <PdfReader client:load />}
      {tool.slug === 'pdf-annotator' && <PdfEditor mode="annotate" client:load />}
      {tool.slug === 'pdf-form-filler' && <FormFiller client:load />}
      {tool.slug === 'redact-pdf' && <RedactPdf client:load />}
      {tool.slug === 'compress-image' && <CompressImage client:load />}
      {tool.slug === 'resize-image' && <ResizeImage client:load />}
      {tool.slug === 'crop-image' && <CropImage client:load />}
      {tool.slug === 'convert-image' && <ConvertImage client:load />}
      {tool.slug === 'rotate-image' && <RotateImage client:load />}
      {tool.slug === 'image-to-base64' && <ImageToBase64 client:load />}
      {tool.slug === 'remove-pages' && <PdfPages mode="remove" client:load />}
      {tool.slug === 'extract-pages' && <PdfPages mode="extract" client:load />}
      {tool.slug === 'reorder-pdf-pages' && <PdfPages mode="reorder" client:load />}
      {tool.slug === 'rotate-pdf' && <PdfPages mode="rotate" client:load />}
      {tool.slug === 'add-blank-page' && <PdfPages mode="blank" client:load />}
      {tool.category === 'imgconv' && <FormatConvert from={tool.from!} to={tool.to!} accept={tool.accept!} client:load />}
      {tool.slug === 'edit-pdf' && <PdfEditor client:load />}
      {tool.slug === 'sign-pdf' && <PdfEditor mode="sign" client:load />}
      {tool.slug === 'add-page-numbers' && <PdfEdit mode="numbers" client:load />}
      {tool.slug === 'add-watermark' && <PdfEdit mode="watermark" client:load />}
      {tool.slug === 'crop-pdf' && <PdfEdit mode="crop" client:load />}
      {tool.slug === 'flatten-pdf' && <PdfEdit mode="flatten" client:load />}
      {tool.slug === 'edit-pdf-metadata' && <PdfEdit mode="metadata" client:load />}
      <noscript><p class="error">Please turn on JavaScript to use this tool.</p></noscript>
    </div>
  </section>
  <article class="container narrow content">
    <p>{tool.intro}</p>
    <h2>{tool.howToName}</h2>
    <ol class="steps">{tool.steps!.map((s) => <li>{s}</li>)}</ol>
    <AdSlot />
    <h2>Why use ZentaPDF {tool.name}?</h2>
    <div class="features">{features.map((f) => <div><strong>{f.t}</strong><span>{f.d}</span></div>)}</div>
    <h2>Frequently asked questions</h2>
    {tool.faqs!.map((f) => <details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}
    {guidesForTool(tool.slug).length > 0 && <>
      <h2>Guides</h2>
      <ul class="guide-links">{guidesForTool(tool.slug).map((g) => <li><a href={`/guides/${g.slug}/`}>{g.h1}</a></li>)}</ul>
    </>}
    <h2>Related tools</h2>
    <div class="grid">{related.map((t) => <ToolCard tool={t} />)}</div>
    {sameCat.length > 0 && <>
      <h2>More {cat.name} tools</h2>
      <ul class="link-chips">{sameCat.map((t) => <li><a href={`/${t.slug}/`}>{t.name}</a></li>)}</ul>
      <p><a href={`/${cat.slug}/`}>All {cat.name} tools →</a></p>
    </>}
    <h2>Popular tools</h2>
    <ul class="link-chips">{popular.map((t) => <li><a href={`/${t.slug}/`}>{t.name}</a></li>)}<li><a href="/device-test/">Device tests</a></li></ul>
  </article>
</Base>
