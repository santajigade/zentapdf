---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolCard from '../components/ToolCard.astro';
import { categories, tools, type Category } from '../data/tools';
import { breadcrumbSchema } from '../lib/schema';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props as { cat: Category };
const list = tools.filter((t) => t.category === cat.id).sort((a, b) => Number(b.live) - Number(a.live));
const crumbs = [{ name: 'Home', href: '/' }, { name: cat.name, href: `/${cat.slug}/` }];
---
<Base title={cat.title} description={cat.description} schema={[breadcrumbSchema(crumbs)]}>
  <Breadcrumbs items={crumbs} />
  <section class="container">
    <div class="tool-head"><h1>{cat.name} tools</h1><p>{cat.description}</p></div>
    <div class="grid" style="margin-top:24px">{list.map((t) => <ToolCard tool={t} />)}</div>
  </section>
</Base>
