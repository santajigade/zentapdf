---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard from '../../components/ToolCard.astro';
import { guides, type Guide } from '../../lib/guides';
import { toolBySlug, type Tool } from '../../data/tools';
import { dtBySlug, type DeviceTest } from '../../data/devicetests';
import DTCard from '../../components/DTCard.astro';
import { breadcrumbSchema, faqSchema, abs } from '../../lib/schema';
import { SITE_NAME } from '../../config.js';
import AuthorBox from '../../components/AuthorBox.astro';
import { AUTHOR, authorSchema } from '../../data/author';

export function getStaticPaths() { return guides.map((g) => ({ params: { slug: g.slug }, props: { g } })); }
const { g } = Astro.props as { g: Guide };
// a guide can point to a PDF/image tool ("merge-pdf") or a device test ("dt:mic-test")
const asLink = (s: string) => { if (s.startsWith('dt:')) { const d = dtBySlug(s.slice(3)); return d && { name: d.name, short: d.short, href: `/device-test/${d.slug}/`, dt: d }; } const t = toolBySlug(s); return t && { name: t.name, short: t.short, href: `/${t.slug}/`, tool: t }; };
const tool = asLink(g.tool)!;
const relatedLinks = [g.tool, ...(g.tools ?? [])].map(asLink).filter(Boolean) as any[];
const more = guides.filter((x) => x.slug !== g.slug).slice(0, 3);
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Guides', href: '/guides/' }, { name: g.h1, href: `/guides/${g.slug}/` }];
const img = `/og/guides/${g.slug}.png?v=2`;
const fmt = (d: string) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const article = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: g.h1, description: g.description, image: abs(img),
  datePublished: g.date, dateModified: g.updated ?? g.date, mainEntityOfPage: abs(`/guides/${g.slug}/`), wordCount: g.words,
  author: authorSchema(),
  publisher: { '@type': 'Organization', name: SITE_NAME, logo: { '@type': 'ImageObject', url: abs('/favicon-512.png') } },
};
const schema = [breadcrumbSchema(crumbs), article, ...(g.faqs?.length ? [faqSchema(g.faqs)] : [])];
const toc = g.headings.filter((h) => h.depth === 2);
---
<Base title={g.title} description={g.description} schema={schema} ogImage={img} ogType="article">
  <Breadcrumbs items={crumbs} />
  <article class="container guide">
    <header class="guide-head">
      <h1>{g.h1}</h1>
      <p class="guide-meta">By <a class="byline" href={AUTHOR.url}><img src={AUTHOR.photo} alt="" width="28" height="28" />{AUTHOR.name}</a> · Published <time datetime={g.date}>{fmt(g.date)}</time>{g.updated && g.updated !== g.date && <> · Updated <time datetime={g.updated}>{fmt(g.updated)}</time></>} · {g.minutes} min read</p>
      <img class="guide-hero" src={img} alt={g.h1} width="1200" height="630" />
    </header>
    <aside class="guide-cta">
      <div><strong>Try it now: {tool.name}</strong><span>{tool.short} Free, no sign-up{tool.dt ? '' : ', no watermark'}.</span></div>
      <a class="btn btn-primary" href={tool.href}>Open {tool.name} →</a>
    </aside>
    {toc.length > 2 && (
      <nav class="guide-toc" aria-label="Contents"><strong>In this guide</strong><ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
    )}
    <div class="prose guide-body"><g.Content /></div>
    {g.faqs?.length && (
      <section><h2 id="faq">Frequently asked questions</h2>{g.faqs.map((f) => <details class="faq"><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
    )}
    <AuthorBox />
    <p class="guide-views" id="guide-views" data-slug={g.slug} hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><span></span></p>
    <aside class="guide-cta">
      <div><strong>Ready? Use {tool.name} free</strong><span>No sign-up{tool.dt ? ', no download' : ', no watermark'}.</span></div>
      <a class="btn btn-primary" href={tool.href}>Open {tool.name} →</a>
    </aside>
    <h2>{tool.dt ? 'Tests used in this guide' : 'Tools used in this guide'}</h2>
    <div class="grid">{relatedLinks.map((x) => (x.dt ? <DTCard t={x.dt} /> : <ToolCard tool={x.tool} />))}</div>
    <h2>More guides</h2>
    <div class="guide-grid">{more.map((x) => (
      <a class="guide-card" href={`/guides/${x.slug}/`}><img src={`/og/guides/${x.slug}.png?v=2`} alt="" width="1200" height="630" loading="lazy" /><div><strong>{x.h1}</strong><small>{fmt(x.date)} · {x.minutes} min read</small></div></a>
    ))}</div>
  </article>
  <script>
    // page view counter (one count per browser per day)
    const el = document.getElementById('guide-views') as HTMLElement | null;
    if (el) {
      const slug = el.dataset.slug!; const key = `zv:${slug}:${new Date().toISOString().slice(0, 10)}`;
      let seen = false; try { seen = !!localStorage.getItem(key); localStorage.setItem(key, '1'); } catch { /* private mode */ }
      fetch(`/api/views.php?p=${slug}`, seen ? {} : { method: 'POST', headers: { 'X-Zenta': 'view' } })
        .then((r) => r.json()).then((d) => { const n = d[slug]; if (typeof n === 'number' && n > 0) { el.querySelector('span')!.textContent = `${n.toLocaleString('en-IN')} ${n === 1 ? 'view' : 'views'}`; el.hidden = false; } })
        .catch(() => {});
    }
  </script>
</Base>
