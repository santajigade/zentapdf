---
import { deviceTests } from '../data/devicetests';
import Base from '../layouts/Base.astro';
import { categories, tools, toolBySlug, type Tool } from '../data/tools';
import { icon, toolColor } from '../data/icons';
const title = 'ZentaPDF: Free PDF & Image Tools Online (No Sign-up)';
const description = 'Free online PDF and image tools: edit, merge, split, compress and convert PDFs, resize photos to KB, make QR codes and more. Fast, simple, no sign-up.';
const live = tools.filter((t) => t.live);
const T = (s: string) => toolBySlug(s) as Tool;
const col = (t: Tool) => toolColor[t.slug] ?? '#5b5bd6';
const n = (id: string) => live.filter((t) => t.category === id).length;
const catIcon: Record<string, string> = { organise: 'merge', edit: 'editdoc', convert: 'word', security: 'lock', image: 'images', imgconv: 'convert', utility: 'qr', gif: 'gif', topdf: 'plus' };
const order = ['organise', 'edit', 'convert', 'topdf', 'security', 'image', 'imgconv', 'gif', 'utility'];
const cats = order.map((id) => categories.find((c) => c.id === id)!).filter(Boolean);
const cat = (id: string) => cats.find((c) => c.id === id)!;
const chips = ['merge-pdf', 'pdf-to-word', 'compress-pdf', 'reduce-image-size-in-kb', 'sign-pdf'].map(T);
const featured: [string, string][] = [['edit-pdf', 'edit'], ['compress-pdf', 'convert'], ['pdf-to-word', 'organise'], ['merge-pdf', 'image']];
const rows: [string, string[]][] = [
  ['organise', ['merge-pdf', 'split-pdf', 'remove-pages', 'reorder-pdf-pages', 'pages-per-sheet', 'repair-pdf']],
  ['edit', ['edit-pdf', 'sign-pdf', 'add-page-numbers', 'add-watermark', 'pdf-overlay', 'crop-pdf']],
  ['convert', ['pdf-to-word', 'pdf-to-excel', 'pdf-to-jpg', 'pdf-to-ppt', 'extract-images-from-pdf', 'pdf-to-markdown']],
  ['topdf', ['word-to-pdf', 'jpg-to-pdf', 'excel-to-pdf', 'ppt-to-pdf', 'pdf-scanner', 'html-to-pdf']],
  ['image', ['compress-image', 'reduce-image-size-in-kb', 'resize-image', 'crop-image', 'convert-image', 'whatsapp-sticker-maker']],
];
const more = ['security', 'imgconv', 'gif', 'utility'];
// what to offer for a file dropped on the home page (only tools that open a dropped file straight away)
const offers = {
  pdf: ['edit-pdf', 'compress-pdf', 'pdf-to-word', 'sign-pdf', 'merge-pdf', 'split-pdf', 'pdf-to-jpg', 'pdf-to-excel'],
  img: ['compress-image', 'jpg-to-pdf', 'crop-image', 'remove-exif-data'],
  word: ['word-to-pdf'], excel: ['excel-to-pdf'], ppt: ['ppt-to-pdf'],
};
const offerData = Object.fromEntries(Object.entries(offers).map(([k, v]) => [k, v.map(T).filter((t) => t?.live).map((t) => ({ slug: t.slug, name: t.name, color: col(t), icon: icon(t.icon, 20) }))]));
const search = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>';
---
<Base title={title} description={description}>
  <section class="hb-hero">
    <div class="container hb-split">
      <div>
        <h1>Free PDF and image tools that just work</h1>
        <p class="hb-lead">Edit, convert, compress and sign PDFs, or resize photos to any KB. {live.length} tools, no sign-up, no watermark.</p>
        <div class="hb-search-wrap">
          <label class="hb-search"><span set:html={search} /><input id="tool-search" type="search" placeholder="What do you want to do? e.g. compress pdf, 50 kb" aria-label="Search tools" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="hb-results" /></label>
          <div class="hb-results" id="hb-results" role="listbox" hidden></div>
        </div>
        <div class="hb-chips"><b>Popular:</b>{chips.map((t) => <a href={`/${t.slug}/`}>{t.name}</a>)}</div>
      </div>
      <div class="hb-art">
        <div class="hb-drop" id="hb-drop" role="button" tabindex="0" aria-label="Choose a PDF, image or Office file">
          <div class="hb-drop-idle">
            <span class="hb-drop-ic" set:html={icon('upload', 34)} />
            <strong>Drop your file here</strong>
            <span>PDF, JPG, PNG, Word, Excel or PowerPoint</span>
            <span class="btn hb-choose">Choose file</span>
          </div>
          <div class="hb-drop-pick" hidden>
            <strong class="hb-fname"></strong>
            <span>What do you want to do?</span>
            <div class="hb-offers"></div>
            <button type="button" class="hb-other">Choose another file</button>
          </div>
        </div>
        <input id="hb-file" type="file" multiple hidden accept=".pdf,application/pdf,image/*,.doc,.docx,.xls,.xlsx,.ppt,.pptx" />
        <div class="hb-float f1" aria-hidden="true"><span style="background:#16a34a" set:html={icon('compress', 18)} />3.2 MB → 79 KB</div>
        <div class="hb-float f2" aria-hidden="true"><span style="background:#2563eb" set:html={icon('word', 18)} />PDF to Word ready</div>
        <div class="hb-float f3" aria-hidden="true"><span style="background:#7c3aed" set:html={icon('sign', 18)} />Signed ✓</div>
      </div>
    </div>
  </section>


  <section class="hb-spot">
    <div class="container hb-spot-in">
      <div class="hb-spot-txt">
        <span class="hb-tag">★ Most used tool</span>
        <h2>Edit PDF text as easily as a Word document</h2>
        <p>Click any line and type. Your change keeps the same font, size and colour, so nobody can tell the PDF was edited.</p>
        <ul>
          <li><span set:html={icon('editdoc', 18)} />Change existing text in the original font</li>
          <li><span set:html={icon('sign', 18)} />Add text, images, signatures and initials</li>
          <li><span set:html={icon('highlighter', 18)} />Highlight, draw shapes, arrows and ticks</li>
          <li><span set:html={icon('scan', 18)} />Works on scanned pages too</li>
        </ul>
        <div class="hb-spot-cta">
          <a class="btn btn-primary btn-lg" href="/edit-pdf/">Edit a PDF now</a>
          <button type="button" class="btn btn-ghost btn-lg" id="hb-edit-pick">Choose PDF file</button>
          <input id="hb-edit-file" type="file" accept=".pdf,application/pdf" hidden />
        </div>
        <small class="hb-spot-note">Free · No sign-up · No watermark</small>
      </div>
      <div class="hb-demo" aria-hidden="true">
        <div class="hd-bar"><i style="background:#ede9fe;color:#7c3aed">T</i><i style="background:#dbeafe;color:#2563eb">✎</i><i style="background:#dcfce7;color:#16a34a">▢</i><i style="background:#fef3c7;color:#b45309">✓</i><i style="background:#fce7f3;color:#be185d">➚</i><b>Save PDF</b></div>
        <div class="hd-page">
          <div class="hd-head"><span class="hd-logo"></span><span class="hd-title">QUOTATION</span></div>
          <div class="hd-l w70"></div>
          <div class="hd-l w55"></div>
          <div class="hd-edit"><span class="hd-old">Price: ₹ 12,500</span><span class="hd-new">Price: ₹ 11,900</span><span class="hd-caret"></span></div>
          <div class="hd-l w80"></div>
          <div class="hd-l w65 hd-hl"><span></span></div>
          <div class="hd-l w75"></div>
          <div class="hd-l w40"></div>
          <svg class="hd-sig" viewBox="0 0 160 60"><path d="M6 44c14-4 18-30 28-30s-6 34 6 34 14-26 22-26-4 22 8 22 10-14 18-14 4 10 12 10 14-6 22-8 14 0 26-2" /></svg>
          <span class="hd-sigline">Signature</span>
        </div>
        <svg class="hd-cursor" viewBox="0 0 24 24"><path d="M4 2l16 10-7 1.5L10 21z" /></svg>
        <div class="hd-toast">✓ Saved: quotation.pdf</div>
      </div>
    </div>
  </section>

  <div class="container hb">
    <div data-hide-on-search>
      <h2 class="hb-h2">Most used tools</h2>
      <div class="hb-feat">
        {featured.map(([s, tint]) => { const t = T(s); return (
          <a class={`hb-fc tint-${tint}`} href={`/${t.slug}/`}><span class="ic" style={`background:${col(t)}`} set:html={icon(t.icon, 30)} /><strong>{t.name}</strong><span class="d">{t.short}</span><em>Open tool →</em></a>
        ); })}
      </div>

      {rows.map(([id, list]) => { const c = cat(id); return (
        <section class={`hb-row tint-${id}`}>
          <div class="hb-rowhead"><span class="hb-ci" set:html={icon(catIcon[id], 22)} /><h2><a href={`/${c.slug}/`}>{c.name}</a></h2><small>{n(id)} tools</small><a class="hb-all" href={`/${c.slug}/`}>See all →</a></div>
          <div class="hb-cards">{list.map(T).filter((t) => t?.live).map((t) => (
            <a class="hb-tc" href={`/${t.slug}/`}><span class="ic" style={`background:${col(t)}`} set:html={icon(t.icon, 22)} /><strong>{t.name}</strong></a>
          ))}</div>
        </section>
      ); })}

      <h2 class="hb-h2">More categories</h2>
      <div class="hb-more">
        {more.map((id) => { const c = cat(id); return (
          <a class={`tint-${id}`} href={`/${c.slug}/`}><span class="hb-ci" set:html={icon(catIcon[id], 22)} /><strong>{c.name}</strong><small>{n(id)} tools</small></a>
        ); })}
        <a class="tint-device" href="/device-test/"><span class="hb-ci" set:html={icon('keyboard', 22)} /><strong>Device Test</strong><small>{deviceTests.filter((t) => t.live).length} tests</small></a>
      </div>
    </div>

    <details class="hb-alltools" id="all-tools">
      <summary><span>All {live.length} tools</span><small>A to Z by category</small></summary>
      <div class="all-cols">
        {cats.map((c) => (
          <div class={`all-group tint-${c.id}`} data-group>
            <h3><a href={`/${c.slug}/`}>{c.name}</a></h3>
            <ul>
              {live.filter((t) => t.category === c.id).map((t) => (
                <li data-name={`${t.name} ${t.slug.replace(/-/g, ' ')} ${t.short}`.toLowerCase()} data-title={t.name.toLowerCase()}>
                  <a href={`/${t.slug}/`}><span class="dot" style={`background:${col(t)}`} set:html={icon(t.icon, 14)} />{t.name}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p id="no-results" class="status" hidden>No tools match your search.</p>
    </details>

    <section class="hb-how" data-hide-on-search>
      <div class="hb-how-head"><h2>Done in three simple steps</h2><p>No software to install and no account to create. It works in any browser.</p></div>
      <div class="hb-steps">
        <article class="hs1"><span class="hs-ic" set:html={icon('upload', 26)} /><b>Step 1</b><h3>Add your file</h3><p>Drag and drop or tap to choose a PDF, photo or Office file.</p><div class="hs-anim"><i class="hs-file"></i></div></article>
        <article class="hs2"><span class="hs-ic" set:html={icon('editdoc', 26)} /><b>Step 2</b><h3>Choose what to do</h3><p>Edit, convert, compress or sign, with a live preview.</p><div class="hs-anim"><i class="hs-bar"><em></em></i></div></article>
        <article class="hs3"><span class="hs-ic" set:html={icon('extract', 26)} /><b>Step 3</b><h3>Download</h3><p>Your file is ready in seconds, in the best quality.</p><div class="hs-anim"><i class="hs-check">✓</i></div></article>
      </div>
      <div class="hb-trust">
        <div><span style="background:#dcfce7;color:#15803d" set:html={icon('stamp', 22)} /><strong>No Watermark</strong><small>Your files stay clean</small></div>
        <div><span style="background:#dbeafe;color:#1d4ed8" set:html={icon('lock', 22)} /><strong>No Sign-Up</strong><small>No email, no account</small></div>
        <div><span style="background:#ede9fe;color:#6d28d9" set:html={icon('star', 22)} /><strong>Best Quality</strong><small>Sharp text, original fonts</small></div>
        <div><span style="background:#ffedd5;color:#c2410c" set:html={icon('touch', 22)} /><strong>Any Device</strong><small>PC, Mac, Android, iPhone</small></div>
      </div>
    </section>
  </div>

  <script define:vars={{ offerData }}>
    window.__offers = offerData;
  </script>
  <script>
    import { putHandoff } from '../lib/handoff';
    // search: instant results under the box, Enter opens the best match
    const input = document.getElementById('tool-search') as HTMLInputElement;
    const box = document.getElementById('hb-results')!;
    const items = [...document.querySelectorAll<HTMLLIElement>('#all-tools li')].map((li) => ({ a: li.querySelector('a')!, name: li.dataset.name ?? '', title: li.dataset.title ?? '' }));
    const STOP = new Set(['to', 'in', 'a', 'an', 'the', 'for', 'my', 'of', 'and', 'online', 'free', 'tool', 'tools', 'file', 'files', 'how', 'convert', 'converter', 'into']);
    const norm = (q: string) => q.toLowerCase().replace(/(\d+)\s*kb\b/g, '$1kb').replace(/\bjpeg\b/g, 'jpg').replace(/[^a-z0-9 ]+/g, ' ').trim();
    let active = -1, hits: typeof items = [];
    const render = () => {
      box.innerHTML = '';
      if (!input.value.trim()) { box.hidden = true; input.setAttribute('aria-expanded', 'false'); return; }
      if (!hits.length) { box.innerHTML = '<p class="hb-nores">No tool found. Try a shorter word, for example "pdf" or "jpg".</p>'; }
      hits.slice(0, 8).forEach((h, k) => {
        const a = h.a.cloneNode(true) as HTMLAnchorElement; a.setAttribute('role', 'option'); a.id = `hbr-${k}`;
        if (k === active) { a.classList.add('on'); a.setAttribute('aria-selected', 'true'); }
        box.appendChild(a);
      });
      if (hits.length > 8) { const m = document.createElement('a'); m.href = '#all-tools'; m.className = 'hb-moreres'; m.textContent = `See all ${hits.length} matching tools ↓`; m.onclick = () => { showAll(); box.hidden = true; }; box.appendChild(m); }
      box.hidden = false; input.setAttribute('aria-expanded', 'true');
    };
    const search = () => {
      const raw = norm(input.value); const words = raw.split(/\s+/).filter((w) => w && !STOP.has(w));
      const terms = words.length ? words : raw.split(/\s+/).filter(Boolean);
      hits = !raw ? [] : items.map((it) => {
        if (!terms.every((w) => it.name.replace(/(\d+) kb/g, '$1kb').includes(w))) return null;
        const t = it.title; let score = 0;
        if (t === raw || t.replace(/ to /g, ' ') === terms.join(' ')) score += 100;
        terms.forEach((w, k) => { if (t.includes(w)) score += 10 - k; if (t.startsWith(w)) score += 5; });
        if (terms.length > 1 && t.indexOf(terms[0]) > -1 && t.indexOf(terms[0]) < t.indexOf(terms[terms.length - 1])) score += 8; // "png to webp" not "webp to png"
        return { ...it, score };
      }).filter(Boolean).sort((a: any, b: any) => b.score - a.score) as any;
      active = hits.length ? 0 : -1; render(); filterAll(terms);
    };
    // the full A to Z list below follows the search too
    const filterAll = (terms: string[]) => {
      document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
        let shown = 0;
        g.querySelectorAll<HTMLElement>('li').forEach((li) => { const hit = !terms.length || terms.every((w) => (li.dataset.name ?? '').replace(/(\d+) kb/g, '$1kb').includes(w)); li.hidden = !hit; if (hit) shown++; });
        g.hidden = shown === 0;
      });
    };
    const showAll = () => { const d = document.getElementById('all-tools') as HTMLDetailsElement; d.open = true; };
    input.addEventListener('input', search);
    input.addEventListener('focus', () => { if (input.value.trim()) render(); });
    input.addEventListener('keydown', (e) => {
      const n = Math.min(hits.length, 8);
      if (e.key === 'ArrowDown' && n) { e.preventDefault(); active = (active + 1) % n; render(); }
      else if (e.key === 'ArrowUp' && n) { e.preventDefault(); active = (active - 1 + n) % n; render(); }
      else if (e.key === 'Enter') { e.preventDefault(); if (hits[active]) location.href = hits[active].a.href; else if (input.value.trim()) { showAll(); document.getElementById('all-tools')!.scrollIntoView({ behavior: 'smooth' }); } }
      else if (e.key === 'Escape') { box.hidden = true; }
    });
    document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.hb-search-wrap')) box.hidden = true; });
    const ef = document.getElementById('hb-edit-file') as HTMLInputElement;
    document.getElementById('hb-edit-pick')?.addEventListener('click', () => ef.click());
    ef.addEventListener('change', async () => { if (!ef.files?.length) return; try { await putHandoff([ef.files[0]]); } catch { /* opens empty */ } location.href = '/edit-pdf/?from=home'; });
    // drop a file: suggest tools, then open the tool with the file already loaded
    const drop = document.getElementById('hb-drop')!, file = document.getElementById('hb-file') as HTMLInputElement;
    const idle = drop.querySelector<HTMLElement>('.hb-drop-idle')!, pick = drop.querySelector<HTMLElement>('.hb-drop-pick')!;
    let files: File[] = [];
    const kind = (f: File) => /pdf$/i.test(f.type) || /\.pdf$/i.test(f.name) ? 'pdf' : /^image\//.test(f.type) ? 'img' : /\.docx?$/i.test(f.name) ? 'word' : /\.xlsx?$/i.test(f.name) ? 'excel' : /\.pptx?$/i.test(f.name) ? 'ppt' : '';
    const show = (list: File[]) => {
      const k = kind(list[0]); const offers = (window as any).__offers[k] as { slug: string; name: string; color: string; icon: string }[] | undefined;
      if (!offers) { alert('Please choose a PDF, image, Word, Excel or PowerPoint file.'); return; }
      files = list.filter((f) => kind(f) === k);
      pick.querySelector('.hb-fname')!.textContent = files.length > 1 ? `${files.length} files` : files[0].name;
      const box = pick.querySelector('.hb-offers')!; box.innerHTML = '';
      for (const o of offers) {
        const b = document.createElement('button'); b.type = 'button';
        b.innerHTML = `<span style="background:${o.color}">${o.icon}</span>${o.name}`;
        b.onclick = async () => { try { await putHandoff(files); } catch { /* the tool opens without the file */ } location.href = `/${o.slug}/?from=home`; };
        box.appendChild(b);
      }
      idle.hidden = true; pick.hidden = false; drop.parentElement!.classList.add('picked');
    };
    const choose = () => { file.click(); };
    drop.addEventListener('click', (e) => { if (!idle.hidden && !(e.target as HTMLElement).closest('.hb-drop-pick')) choose(); });
    drop.addEventListener('keydown', (e) => { if ((e.key === 'Enter' || e.key === ' ') && !idle.hidden) { e.preventDefault(); choose(); } });
    pick.querySelector('.hb-other')!.addEventListener('click', (e) => { e.stopPropagation(); choose(); });
    file.addEventListener('change', () => { if (file.files?.length) show(Array.from(file.files)); file.value = ''; });
    drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
    drop.addEventListener('dragleave', () => drop.classList.remove('over'));
    drop.addEventListener('drop', (e) => { e.preventDefault(); drop.classList.remove('over'); if (e.dataTransfer?.files.length) show(Array.from(e.dataTransfer.files)); });
  </script>
</Base>
