  "name": "Payment Receipt Template",
  "h1": "Payment Receipt Template (Word, Excel and PDF)",
  "metaTitle": "Payment Receipt Template: Free Word, Excel & PDF Format",
  "metaDescription": "Free payment receipt template in Word, Excel and PDF. Two receipts per A4 page, balance due worked out for you, and a receipt log with totals by payment mode.",
  "short": "Simple money receipt for any payment, two per page, with an Excel receipt log that totals what you received.",
  "accent": "#9D174D",
  "useCases": [
    "Billing",
    "Freelance"
  ],
  "industries": [
    "Small business",
    "Freelancers",
