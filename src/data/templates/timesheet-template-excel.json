{
  "slug": "timesheet-template-excel",
  "category": "excel",
  "name": "Weekly Timesheet Template Excel",
  "h1": "Weekly Timesheet Template in Excel (Hours, Overtime and Pay)",
  "metaTitle": "Timesheet Template Excel: Free Weekly Timesheet",
  "metaDescription": "Free weekly timesheet in Excel. Enter time in, time out and breaks; hours, overtime and gross pay calculate by themselves. Print, sign or save as PDF.",
  "short": "One-page weekly timesheet: hours, daily and weekly overtime and gross pay work out from time in and out.",
  "accent": "#C2410C",
  "useCases": [
    "HR",
    "Payroll",
    "Tracking"
  ],
  "industries": [
    "Small business",
    "Freelancers",
    "All industries"
  ],
  "date": "2026-11-16",
  "intro": "This weekly timesheet in Excel turns time in, time out and break minutes into hours worked, overtime and gross pay. You set the hourly rate, the normal hours a day and a week, and the overtime rate to match your own job. It fits on one page with space for the employee and manager to sign.",
  "howTo": [
    "Download the Excel file and open it in Microsoft Excel, Google Sheets or LibreOffice Calc.",
    "Fill in the employee name, ID, department and manager at the top.",
    "Type the first day of the week in Week starting. The days and dates for all seven rows fill in by themselves.",
    "Set the hourly rate, the normal hours a day, the normal hours a week and the overtime rate in the settings band.",
    "For each day, type the time in and time out in 24 hour format, like 09:30 and 18:30, and the break in minutes.",
    "Check the week summary for total hours, overtime hours and gross pay.",
    "Print the sheet or save it as PDF, then sign it and send it to the manager for approval."
  ],
  "guide": [
    {
      "h": "What is inside the file",
      "p": [
        "One sheet with employee details, a settings band, a seven day table and a week summary. The table has Day, Date, Time in, Time out, Break (min), Hours worked, Normal hours, Overtime (day) and Notes. Overtime cells turn red on days that go past the daily limit.",
        "The summary shows total hours, overtime by day, overtime by week, overtime hours paid, normal hours paid, normal pay, overtime pay and gross pay, followed by two signature boxes."
      ]
    },
    {
      "h": "How hours and overtime are calculated",
      "p": [
        "Hours worked is time out minus time in, minus the break. The formula uses MOD, so a night shift that starts at 22:00 and ends at 06:00 still counts as 8 hours.",
        "The sheet works out overtime two ways: hours above the daily limit added up over the week, and hours above the weekly limit. It pays the **larger** of the two, so the same hour is never counted twice. If your employer only uses a weekly limit, set the daily limit to 24."
      ]
    },
    {
      "h": "Overtime rules differ",
      "p": [
        "There is no single rule for overtime. The daily and weekly limits, the overtime rate and who qualifies depend on the country, state, industry and the employment contract. The sample uses 9 hours a day, 48 a week and 1.5 times pay only as example numbers. Check the labour rules that apply to you or ask your HR team before using the sheet for payroll."
      ]
    }
  ],
  "tips": [
    "Fill the timesheet every day rather than from memory at the end of the week.",
    "Leave time in and time out blank on weekly offs and leave days, and write the reason in Notes.",
    "Use the Notes column for client names or project codes if you bill your hours.",
    "Save each signed week as a PDF with the week date in the file name."
  ],
  "faqs": [
    {
      "q": "Can I use this timesheet in Google Sheets?",
      "a": "Yes. Upload the file to Google Drive and open it with Google Sheets. Type times with a colon, like 09:30, so they are read as times."
    },
    {
      "q": "Does it handle night shifts?",
      "a": "Yes. If the time out is earlier than the time in, the sheet treats it as the next morning, so 22:00 to 06:00 counts as 8 hours before the break."
    },
    {
      "q": "How do I use it without overtime?",
      "a": "Set the normal hours a day to 24 and the hours a week to 168. Overtime then stays at zero and every hour is paid at the normal rate."
    },
    {
      "q": "Does gross pay include tax or PF deductions?",
      "a": "No. Gross pay is hours multiplied by the rates you set. Deductions such as income tax, PF or ESI depend on official rules and the salary structure, so they are not included."
    },
    {
      "q": "Can I track two weeks or a month?",
      "a": "Make a copy of the sheet tab for each week. Right click the tab name, choose Move or Copy, tick Create a copy, then change the Week starting date."
    }
  ],
