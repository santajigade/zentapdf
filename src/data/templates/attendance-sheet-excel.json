{
  "slug": "attendance-sheet-excel",
  "category": "excel",
  "name": "Attendance Sheet in Excel",
  "h1": "Attendance Sheet in Excel (Monthly, Free Excel and PDF)",
  "metaTitle": "Attendance Sheet in Excel: Free Monthly Template",
  "metaDescription": "Free monthly attendance sheet in Excel for staff or students. P, A, L and H codes, auto totals and attendance percentage. Print ready, no macros.",
  "short": "Monthly attendance register for 20 staff or students with day codes, totals and attendance %.",
  "accent": "#4338CA",
  "useCases": [
    "Tracking",
    "HR"
  ],
  "industries": [
    "Small business",
    "Schools",
    "All industries"
  ],
  "date": "2026-11-10",
  "intro": "This monthly attendance sheet in Excel has one row per person and one column per day. Type a code such as P or A in each cell and the sheet counts present, absent, leave and half days, then works out each person's attendance percentage. It works for an office team, a shop or a classroom of up to 20 people.",
  "howTo": [
    "Download the Excel file and open it in Microsoft Excel, Google Sheets or LibreOffice Calc.",
    "Type the first day of the month as a date in the Month cell. The day numbers, weekday letters and days in month change by themselves.",
    "Add your organisation, department and the names and IDs of your staff or students. Delete the sample names first.",
    "Each day, pick a code from the drop-down in every cell: P present, A absent, L leave, H half day, O weekly off or holiday.",
    "Read the totals on the right and the Present each day row at the bottom. Attendance below 75% turns red.",
    "At month end, print the sheet on one landscape page or save it as PDF, then save a copy of the file for the next month."
  ],
  "guide": [
    {
      "h": "How the formulas work",
      "p": [
        "Each total column uses COUNTIF to count one code across the 31 day cells in that row. **Work days** adds P, A, L and H, so weekly offs and holidays marked O do not count against anyone. **Attend. %** is present days plus half of the half days, divided by work days.",
        "The day numbers and weekday letters at the top are formulas too. They read the Month cell, so in a 30 day month the 31st column stays blank, and in February only 28 or 29 days show."
      ]
    },
    {
      "h": "Leave rules differ, so check yours",
      "p": [
        "Organisations count leave in different ways. Some treat paid leave as present, some count only present days, and schools often have their own minimum attendance rules. This sheet keeps leave separate and does not decide pay. If your policy is different, change the formula in the Attend. % column, and check your company policy, school rules or local labour rules before you use the numbers for pay or exams."
      ]
    },
    {
      "h": "Keeping records month by month",
      "p": [
        "Save one file or one copy of the sheet for each month instead of typing over last month. Many employers have to keep attendance and wage records for a number of years, and the period depends on your country and state, so check the official rules that apply to you. A PDF copy at month end is an easy, fixed record to share with a manager or accountant."
      ]
    }
  ],
  "tips": [
    "Use the drop-down so codes stay the same. A typed \"p \" with a space will not be counted.",
    "Mark holidays and weekly offs with O for everyone so nobody's percentage drops.",
    "Need more than 20 people? Insert rows inside the staff list and copy the formulas from the row above into the new rows.",
    "Freeze panes are set, so names and dates stay in view while you scroll."
  ],
  "faqs": [
    {
      "q": "Can I use this attendance sheet for students?",
      "a": "Yes. Put the class or section in the Department cell, student names in the Name column and roll numbers in the ID column. The codes and percentage work the same way."
    },
    {
      "q": "Does it work in Google Sheets?",
      "a": "Yes. Upload the file to Google Drive and open it with Google Sheets. The drop-downs, formulas and red highlights all keep working."
    },
    {
      "q": "How is the attendance percentage worked out?",
      "a": "It is (P + half of H) divided by (P + A + L + H). Weekly offs and holidays marked O are left out. You can change the formula if your organisation counts leave as present."
    },
    {
      "q": "Does it track hours or overtime?",
      "a": "No. It records whether each person was present each day. To track hours worked, use a timesheet instead."
    },
    {
      "q": "How do I start a new month?",
      "a": "Save a copy of the file, clear the day cells, then change the Month cell to the first day of the new month. The day numbers and weekday letters update by themselves."
    }
  ],
