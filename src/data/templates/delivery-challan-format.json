  "name": "Delivery Challan Format",
  "h1": "Delivery Challan Format (Excel, Word and PDF)",
  "metaTitle": "Delivery Challan Format: Free Excel, Word & PDF",
  "metaDescription": "Free delivery challan format in Excel, Word and PDF. Consignor, consignee, transport details, HSN, item list with value and a receiver signature. Easy to print.",
  "short": "Goods delivery challan with copy marking, transport details, HSN item list, total value and receiver signature.",
  "accent": "#4C1D95",
  "useCases": [
    "GST",
    "Sales"
